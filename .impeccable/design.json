  "narrative": {
    "northStar": "Fresco glass with physical objects",
    "overview": "Tandem retains Fresco's charcoal background, smoked liquid glass, reflective edges, warm text and pale blue accent. A rotatable cartridge and an angled monitor provide recognizable physical forms. Raised buttons and inset selected navigation retain subdued gradients and highlights.\n\nThe current desktop preview provides ROM inspection and raw controller detection. Its partner monitor displays a non-interactive NO SIGNAL and Partner offline placeholder. Emulation and networking are not implemented. This document records the current renderer; removed keyboard and session-demo surfaces do not define the current system.",
    "keyCharacteristics": [
      "Smoked glass and charcoal surfaces with selective reflective edges.",
      "Runtime 3D cartridge and monitor objects with material lighting.",
      "Sans-serif interface headings and a serif wordmark.",
      "Offline partner status attached to the monitor's screen plane."
    ],
    "rules": [
      {
        "name": "The Status Rule",
        "body": "Keep unavailable features and verified checks explicitly distinguishable in visible copy.",
        "section": "colors"
      },
      {
        "name": "The Type Role Rule",
        "body": "Preserve the serif wordmark and use sans-serif for interface headings, controls and status.",
        "section": "typography"
      },
      {
        "name": "The Object Source Rule",
        "body": "Use realistic, externally sourced 3D models for physical objects; preserve their attribution and licenses rather than substituting procedural or CSS approximations. Source and modification details live in `docs/ASSETS.md`.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain Fresco smoke, reflective edges and the charcoal background.",
      "Do preserve sourced model geometry, shell textures, material lighting and attribution.",
      "Do place offline status on the monitor's screen plane.",
      "Do distinguish the sourced cartridge model from its adapted box-art label.",
      "Do preserve visible focus, readable status and wrapping technical values."
    ],
    "donts": [
      "Don't present the offline placeholder as working networking.",
      "Don't add floor planes or cast floor shadows beneath the objects.",
      "Don't substitute procedural or CSS approximations for externally sourced physical models.",
      "Don't hide the cartridge when the fingerprint opens, including at viewport heights of 700px and below.",
      "Don't restore removed keyboard or session-demo surfaces as established components."
    ]
  }
